// 手写模拟器主窗口。
//
// 阶段 3：GUI 功能对齐 Python 版（1:1）。
// - 参数控件通过 `<=>` 双向绑定暴露给 Rust 侧（get_/set_ 方法）
// - 预览区显示引擎输出的 RGBA 图像（Rust 侧 set_preview_image），支持翻页与底色切换
// - 预设下拉框（Rust 侧 VecModel<String> 驱动）快捷切换
// - 文字颜色 / 边距 / 扰动 σ / 边界提示（对齐 Python 版 ui.py 控件集）
//
// 样式对齐 Python 版 gui/ui.py：
// - 布局方向：左侧预览区（可伸缩）+ 翻页导航，右侧固定 400px 参数面板 + 「预览/导出」主按钮
// - 配色与按钮/分组框样式见 theme.slint（对应 Python `_LIGHT_QSS`）
// - 排版参数为「数值 | 扰动 σ」表格，笔画扰动/边距使用带标题的分组框

import {
    CheckBox,
    ComboBox,
    LineEdit,
    ScrollView,
    Slider,
    SpinBox,
} from "std-widgets.slint";
import {
    Theme,
    GreenButton,
    PrimaryButton,
    GroupTitle,
    SectionLabel,
    FieldLabel,
} from "theme.slint";

// 段落数据：逐段编辑器的一行（对齐 Python 版 QTextEdit 逐段块格式）。
// indent-em 为首行缩进的字符数倍数（2 = 缩进两字符，渲染时 × 当前字号换算像素）。
// est-lines 为 Rust 侧估算的编辑器内显示行数（Slint TextInput 在嵌套布局下
// 行高不随换行自适应，需要按估算行数给足 min-height，宁可多留白也不裁剪）。
export struct ParaRow {
    text: string,
    align: int,          // 0 左对齐 / 1 居中 / 2 右对齐
    indent-em: float,    // 首行缩进（字符数；0 = 不缩进）
    est-lines: int,      // 编辑器内估算显示行数（≥1）
    trailing-space-em: float, // 末尾空格宽度（em 数）；右对齐占位用
}

// 框选文字区域（对应 Python 版 TextRegion）：坐标为预览图源像素。
export struct RegionInfo {
    x: float,
    y: float,
    w: float,
    h: float,
    page: int,     // 起始页（1 基）
    label: string, // 列表显示摘要
}

export component MainWindow inherits Window {
    title: "手写模拟器";
    icon: @image-url("app-icon.png");
    preferred-width: 1280px;
    preferred-height: 840px;
    background: Theme.bg;

    // ---- 双向绑定参数（Rust 侧 get_/set_ 访问） ----
    // 待处理文本：逐段编辑器（ParaRow 模型，Rust 侧 VecModel 驱动）
    in-out property <[ParaRow]> paragraphs: [];
    // 分段/合并后请求聚焦的段落索引 + 变更令牌（自增触发 delegate 内 focus()）
    in property <int> focus-row: -1;
    in property <int> focus-nonce: 0;
    in-out property <int> font-size <=> font-size-spin.value;
    in-out property <int> line-spacing <=> line-spacing-spin.value;
    in-out property <int> word-spacing <=> word-spacing-spin.value;
    // 排版参数扰动 σ（对齐 Python 版 σ 列）
    in-out property <int> word-spacing-sigma <=> word-spacing-sigma-spin.value;
    in-out property <int> line-spacing-sigma <=> line-spacing-sigma-spin.value;
    in-out property <int> font-size-sigma <=> font-size-sigma-spin.value;
    in-out property <int> perturb-x <=> perturb-x-spin.value;
    in-out property <int> perturb-y <=> perturb-y-spin.value;
    // 笔画旋转：浮点数直接输入（对齐 Python 版 QDoubleSpinBox）
    in-out property <string> perturb-theta-text <=> perturb-theta-edit.text;
    // 写错字模拟：错字率（0~30%）+ 重写方式 + 涂改方式
    in-out property <float> miswrite-rate <=> miswrite-rate-slider.value;
    in-out property <int> miswrite-mode-index <=> miswrite-mode-combo.current-index;
    in-out property <int> miswrite-strikeout-style-index <=> miswrite-strikeout-combo.current-index;
    in-out property <string> font-path-text <=> font-path-edit.text;
    in-out property <string> background-path-text <=> background-path-edit.text;
    // 文字颜色（#RRGGBB）
    in-out property <string> font-color <=> font-color-edit.text;
    // 边距（位置式布局：上/下/左/右）
    in-out property <int> margin-top <=> margin-top-spin.value;
    in-out property <int> margin-bottom <=> margin-bottom-spin.value;
    in-out property <int> margin-left <=> margin-left-spin.value;
    in-out property <int> margin-right <=> margin-right-spin.value;
    // 边界提示（仅预览）：开关 + 提示颜色
    in-out property <bool> bounds-visible <=> bounds-check.checked;
    in-out property <string> bounds-color <=> bounds-color-edit.text;
    in-out property <length> para-viewport-y: 0px;

    // ---- 预设下拉框（Rust 侧 VecModel<String> 驱动） ----
    in-out property <[string]> preset-list;
    in property <int> preset-index: 0;

    // ---- Rust → UI ----
    in property <string> status-text: "就绪";
    in property <image> preview-image;
    in property <string> page-text: "第 1 / 1 页";
    // 预览区底色（对齐 Python 版 PreviewLabel 初始 #c8d0ca）
    in-out property <color> preview-bg: #c8d0ca;
    // 当前页索引（0 基）：区域叠加只显示属于当前页的区域
    in property <int> current-page-index: 0;
    // 预览图自然尺寸（Rust 在 show_page 时设置；0 = 无预览）
    in property <float> preview-nat-w: 0.0;
    in property <float> preview-nat-h: 0.0;
    // 背景原始像素 → 预览像素的缩放比（≤1，降采样时小于 1；无降采样为 1）。
    // 区域模型存的是背景原始像素坐标：叠加/编辑框显示几何 = 原始 × 本系数 × fit-scale
    in property <float> bg-preview-scale: 1.0;

    // ---- 框选文字区域（对应 Python 版 PreviewLabel + 区域列表面板） ----
    in-out property <bool> region-mode: false;   // 框选模式开关（十字光标 + 拖拽新建）
    in property <[RegionInfo]> regions;          // 全部区域
    in property <int> editing-index: -1;         // 正在二次调整的区域索引（-1 = 无）
    in property <int> highlight-index: -1;       // 列表悬浮临时高亮的区域索引
    in-out property <bool> dialog-open: false;   // 区域编辑对话框（窗口内覆盖层）
    in-out property <string> dialog-text;        // 对话框：区域文字
    in-out property <int> dialog-style-index: 0; // 对话框：0 手写体 / 1 打印体
    in-out property <int> dialog-page: 1;        // 对话框：起始页
    in-out property <string> dialog-font-path;   // 对话框：打印字体路径（空 = 主字体）
    in-out property <int> dialog-font-size: 0;   // 对话框：字号（0 = 跟随主设置）
    in-out property <int> dialog-target-index: -1; // 对话框编辑的区域索引（-1 = 新建）
    in property <[string]> region-labels;        // 区域列表摘要
    in-out property <int> region-selected-index: -1; // 列表当前选中行
    in property <string> doc-status-text: "";    // 文档底图状态提示

    // 模式统一：逐段编辑器 + 段工具按钮（对齐 Python 版 QTextEdit 交互）。
    // 当前光标所在段的格式提示（Rust 侧维护）
    in property <string> para-status-text: "光标定位到段落后可用按钮设置格式";

    // ---- UI → Rust 回调 ----
    callback regenerate;
    callback choose-font;
    callback choose-background;
    callback export-files;
    callback import-docx;
    callback save-preset;
    callback load-preset;
    // 段落工具：编辑段文本 / 设置当前段对齐 / 首行缩进开关 / 光标所在段变更
    callback para-text-edited(int, string);
    callback para-set-align(int);
    callback para-indent-toggle(bool);
    callback para-cursor-moved(int);
    // 段落结构：回车在光标处分段 / 段首退格并入上一段 / 聚焦最后一段（空白区点击）
    callback para-split(int, int);
    callback para-merge-prev(int);
    callback para-focus-last();
    callback preset-selected(int);
    callback prev-page;
    callback next-page;
    callback toggle-preview-bg;
    callback export-pdf;
    // 框选区域：新建完成 / 二次调整写回 / 取消调整 / 列表交互 / 增删
    callback region-selected(float, float, float, float);
    callback region-geometry-changed(int, float, float, float, float);
    callback region-edit-cancelled();
    callback region-item-clicked(int);
    callback region-item-hovered(int);
    callback region-edit-requested(int);
    callback region-delete(int);
    callback region-clear();
    callback toggle-region-mode();
    // 区域对话框：确认（index < 0 = 新建）/ 取消 / 选打印字体 / 导入文档底图
    callback region-dialog-confirmed(int, string, bool, string, int, int);
    callback region-dialog-cancelled();
    callback choose-region-font();
    callback import-document;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 10px;

            // ---- 左侧：预览区 + 翻页导航（对齐 Python 版左列） ----
            VerticalLayout {
                spacing: 6px;
                horizontal-stretch: 1;

                // ---- 预览区：contain 居中 + 框选交互（对应 Python 版 PreviewLabel） ----
                preview-box := Rectangle {
                    background: preview-bg;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.group-border;
                    vertical-stretch: 1;

                    // ---- contain-fit 几何（复刻 image-fit:contain 并暴露精确绘制矩形，
                    //      供鼠标坐标 ↔ 源图像素换算） ----
                    property <float> nat-w: root.preview-nat-w > 0.0 ? root.preview-nat-w : 1.0;
                    property <float> nat-h: root.preview-nat-h > 0.0 ? root.preview-nat-h : 1.0;
                    property <float> fit-scale: min(self.width / nat-w, self.height / nat-h) / 1px;
                    property <length> draw-w: nat-w * fit-scale * 1px;
                    property <length> draw-h: nat-h * fit-scale * 1px;
                    property <length> off-x: (self.width - draw-w) / 2;
                    property <length> off-y: (self.height - draw-h) / 2;

                    Image {
                        x: parent.off-x;
                        y: parent.off-y;
                        width: parent.draw-w;
                        height: parent.draw-h;
                        source: preview-image;
                        visible: root.preview-nat-w > 0.0;
                    }

                    // 已有区域叠加（红框 + 浅填充；编辑中/跨页的不显示）
                    for r[i] in root.regions: Rectangle {
                        visible: (r.page - 1) == root.current-page-index
                            && r.w > 0.0
                            && i != root.editing-index;
                        x: parent.off-x + r.x * parent.fit-scale * root.bg-preview-scale * 1px;
                        y: parent.off-y + r.y * parent.fit-scale * root.bg-preview-scale * 1px;
                        width: max(1px, r.w * parent.fit-scale * root.bg-preview-scale * 1px);
                        height: max(1px, r.h * parent.fit-scale * root.bg-preview-scale * 1px);
                        border-width: 2px;
                        border-color: #e5484d;
                        background: i == root.highlight-index ? #e5484d55 : #e5484d1c;
                    }

                    // ---- 交互层：橡皮筋框选 + 编辑框拖动/缩放（坐标系 = 显示图矩形） ----
                    sel := TouchArea {
                        x: parent.off-x;
                        y: parent.off-y;
                        width: parent.draw-w;
                        height: parent.draw-h;
                        // 无预览时不拦截鼠标
                        enabled: root.preview-nat-w > 0.0;

                        // 交互状态（对应 Python PreviewLabel 的 _origin/_adjust/_press_*）
                        property <int> mode: 0;         // 0 空闲 / 1 新建框选 / 2 调整编辑框
                        property <string> zone: "none"; // move/tl/tr/bl/br/l/r/t/b
                        property <length> press-x: 0px;
                        property <length> press-y: 0px;
                        // 橡皮筋 / 编辑框拖拽中的实时几何（sel 坐标）
                        property <bool> rubber-live: false;
                        property <length> rb-x: 0px;
                        property <length> rb-y: 0px;
                        property <length> rb-w: 0px;
                        property <length> rb-h: 0px;

                        property <bool> has-edit: root.editing-index >= 0
                            && root.editing-index < root.regions.length;
                        // 编辑框实时几何：交互中取 rb-*，静止时按模型换算
                        // （模型为背景原始像素 → ×bg-preview-scale 转预览像素 → ×fit-scale 转显示）
                        property <length> eb-x: mode != 0 ? rb-x
                            : (has-edit ? root.regions[root.editing-index].x * parent.fit-scale * root.bg-preview-scale * 1px : 0px);
                        property <length> eb-y: mode != 0 ? rb-y
                            : (has-edit ? root.regions[root.editing-index].y * parent.fit-scale * root.bg-preview-scale * 1px : 0px);
                        property <length> eb-w: mode != 0 ? rb-w
                            : (has-edit ? root.regions[root.editing-index].w * parent.fit-scale * root.bg-preview-scale * 1px : 0px);
                        property <length> eb-h: mode != 0 ? rb-h
                            : (has-edit ? root.regions[root.editing-index].h * parent.fit-scale * root.bg-preview-scale * 1px : 0px);

                        // 显示坐标 → 源图像素
                        function src-f(v: length) -> float {
                            return v / (parent.fit-scale * 1px);
                        }
                        function clamp-len(v: length, hi: length) -> length {
                            return max(0px, min(v, hi));
                        }
                        function clamp-f(v: float, hi: float) -> float {
                            return max(0.0, min(v, hi));
                        }
                        // 判定命中编辑框部位（8px 容差，对齐 Python 版 _hit_zone）
                        function zone-at(px: length, py: length) -> string {
                            return !has-edit ? "none"
                                : abs(px - eb-x) <= 8px && abs(py - eb-y) <= 8px ? "tl"
                                : abs(px - (eb-x + eb-w)) <= 8px && abs(py - eb-y) <= 8px ? "tr"
                                : abs(px - eb-x) <= 8px && abs(py - (eb-y + eb-h)) <= 8px ? "bl"
                                : abs(px - (eb-x + eb-w)) <= 8px && abs(py - (eb-y + eb-h)) <= 8px ? "br"
                                : abs(px - eb-x) <= 8px && py >= eb-y && py <= eb-y + eb-h ? "l"
                                : abs(px - (eb-x + eb-w)) <= 8px && py >= eb-y && py <= eb-y + eb-h ? "r"
                                : abs(py - eb-y) <= 8px && px >= eb-x && px <= eb-x + eb-w ? "t"
                                : abs(py - (eb-y + eb-h)) <= 8px && px >= eb-x && px <= eb-x + eb-w ? "b"
                                : px >= eb-x && px <= eb-x + eb-w && py >= eb-y && py <= eb-y + eb-h ? "move"
                                : "none";
                        }
                        function cursor-for(z: string) -> MouseCursor {
                            return z == "tl" || z == "br" ? MouseCursor.nwse-resize
                                : z == "tr" || z == "bl" ? MouseCursor.nesw-resize
                                : z == "l" || z == "r" ? MouseCursor.ew-resize
                                : z == "t" || z == "b" ? MouseCursor.ns-resize
                                : z == "move" ? MouseCursor.move
                                : MouseCursor.crosshair;
                        }
                        // 调整后的新边（仅对应部位跟随鼠标，其余保持原值）
                        function adj-l() -> length {
                            return zone == "l" || zone == "tl" || zone == "bl"
                                ? clamp-len(self.mouse-x, parent.draw-w) : rb-x;
                        }
                        function adj-t() -> length {
                            return zone == "t" || zone == "tl" || zone == "tr"
                                ? clamp-len(self.mouse-y, parent.draw-h) : rb-y;
                        }
                        function adj-r() -> length {
                            return zone == "r" || zone == "tr" || zone == "br"
                                ? clamp-len(self.mouse-x, parent.draw-w) : rb-x + rb-w;
                        }
                        function adj-b() -> length {
                            return zone == "b" || zone == "bl" || zone == "br"
                                ? clamp-len(self.mouse-y, parent.draw-h) : rb-y + rb-h;
                        }

                        mouse-cursor: mode == 1 ? MouseCursor.crosshair
                            : mode == 2 ? cursor-for(zone)
                            : root.region-mode ? MouseCursor.crosshair
                            : has-edit ? cursor-for(zone-at(self.mouse-x, self.mouse-y))
                            : MouseCursor.default;

                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                esc-handler.focus();
                                if (has-edit && zone-at(self.mouse-x, self.mouse-y) == "none") {
                                    // 点击框外空白：先退出调整态（对齐 Python 版点击外部取消）
                                    root.region-edit-cancelled();
                                }
                                if (root.region-mode) {
                                    mode = 1;
                                    press-x = self.mouse-x;
                                    press-y = self.mouse-y;
                                    rb-x = self.mouse-x;
                                    rb-y = self.mouse-y;
                                    rb-w = 0px;
                                    rb-h = 0px;
                                } else if (has-edit && zone-at(self.mouse-x, self.mouse-y) != "none") {
                                    mode = 2;
                                    zone = zone-at(self.mouse-x, self.mouse-y);
                                    press-x = clamp-len(self.mouse-x, parent.draw-w);
                                    press-y = clamp-len(self.mouse-y, parent.draw-h);
                                    rb-x = eb-x;
                                    rb-y = eb-y;
                                    rb-w = eb-w;
                                    rb-h = eb-h;
                                }
                            } else if (ev.kind == PointerEventKind.up && ev.button == PointerEventButton.left) {
                                if (mode == 1) {
                                    mode = 0;
                                    // 过滤误触的极小选区（≥4 源像素，对齐 Python）
                                    if (rb-w >= 4px * parent.fit-scale && rb-h >= 4px * parent.fit-scale) {
                                        root.region-selected(
                                            clamp-f(src-f(rb-x), parent.nat-w),
                                            clamp-f(src-f(rb-y), parent.nat-h),
                                            clamp-f(src-f(rb-w), parent.nat-w),
                                            clamp-f(src-f(rb-h), parent.nat-h));
                                    }
                                } else if (mode == 2) {
                                    mode = 0;
                                    zone = "none";
                                    root.region-geometry-changed(
                                        root.editing-index,
                                        clamp-f(src-f(min(adj-l(), adj-r())), parent.nat-w),
                                        clamp-f(src-f(min(adj-t(), adj-b())), parent.nat-h),
                                        clamp-f(src-f(abs(adj-r() - adj-l())), parent.nat-w),
                                        clamp-f(src-f(abs(adj-b() - adj-t())), parent.nat-h));
                                }
                            }
                        }

                        moved => {
                            if (mode == 1) {
                                rb-x = min(press-x, self.mouse-x);
                                rb-y = min(press-y, self.mouse-y);
                                rb-w = abs(self.mouse-x - press-x);
                                rb-h = abs(self.mouse-y - press-y);
                            } else if (mode == 2 && zone == "move") {
                                // 整体移动：钳制在显示图范围内
                                rb-x = clamp-len(rb-x + (clamp-len(self.mouse-x, parent.draw-w) - press-x), parent.draw-w - rb-w);
                                rb-y = clamp-len(rb-y + (clamp-len(self.mouse-y, parent.draw-h) - press-y), parent.draw-h - rb-h);
                                press-x = clamp-len(self.mouse-x, parent.draw-w);
                                press-y = clamp-len(self.mouse-y, parent.draw-h);
                            } else if (mode == 2) {
                                // 边/角缩放：过小增量忽略，保持上一几何（≥3 显示像素）
                                rb-x = abs(adj-r() - adj-l()) >= 3px && abs(adj-b() - adj-t()) >= 3px
                                    ? min(adj-l(), adj-r()) : rb-x;
                                rb-y = abs(adj-r() - adj-l()) >= 3px && abs(adj-b() - adj-t()) >= 3px
                                    ? min(adj-t(), adj-b()) : rb-y;
                                rb-w = abs(adj-r() - adj-l()) >= 3px && abs(adj-b() - adj-t()) >= 3px
                                    ? abs(adj-r() - adj-l()) : rb-w;
                                rb-h = abs(adj-r() - adj-l()) >= 3px && abs(adj-b() - adj-t()) >= 3px
                                    ? abs(adj-b() - adj-t()) : rb-h;
                            }
                        }

                        // 橡皮筋（新建拖拽中）
                        Rectangle {
                            visible: parent.mode == 1;
                            x: parent.rb-x;
                            y: parent.rb-y;
                            width: parent.rb-w;
                            height: parent.rb-h;
                            border-width: 2px;
                            border-color: #4a90ff;
                            background: #4a90ff20;
                        }                        // 二次调整编辑框（四角手柄）
                        Rectangle {
                            visible: parent.has-edit;
                            x: parent.eb-x;
                            y: parent.eb-y;
                            width: parent.eb-w;
                            height: parent.eb-h;
                            border-width: 2px;
                            border-color: #2f7df6;
                            background: #2f7df610;
                            Rectangle { x: -4px; y: -4px; width: 8px; height: 8px; background: white; border-width: 1px; border-color: #2f7df6; }
                            Rectangle { x: parent.width - 4px; y: -4px; width: 8px; height: 8px; background: white; border-width: 1px; border-color: #2f7df6; }
                            Rectangle { x: -4px; y: parent.height - 4px; width: 8px; height: 8px; background: white; border-width: 1px; border-color: #2f7df6; }
                            Rectangle { x: parent.width - 4px; y: parent.height - 4px; width: 8px; height: 8px; background: white; border-width: 1px; border-color: #2f7df6; }
                        }
                    }

                    // Esc 退出调整态
                    esc-handler := FocusScope {
                        key-pressed(event) => {
                            if (event.text == "\u{1b}" && root.editing-index >= 0) {
                                root.region-edit-cancelled();
                                accept
                            } else {
                                reject
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    GreenButton {
                        text: "◀ 上一页";
                        clicked => { root.prev-page(); }
                    }
                    Text {
                        text: page-text;
                        horizontal-stretch: 1;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        font-family: "楷体";
                        font-size: Theme.base-font;
                        color: Theme.text;
                    }
                    GreenButton {
                        text: "下一页 ▶";
                        clicked => { root.next-page(); }
                    }
                    GreenButton {
                        text: "预览底色";
                        clicked => { root.toggle-preview-bg(); }
                    }
                }
            }

            // ---- 右侧：参数面板（可滚动）+ 主按钮 ----
            VerticalLayout {
                width: 460px;
                spacing: 8px;

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 6px;
                        padding-right: 10px;
                        spacing: 8px;

                        // ---- 待处理文本（单框 + 光标段工具按钮，对齐 Python 版交互） ----
                        SectionLabel { text: "待处理文本"; }
                        HorizontalLayout {
                            spacing: 4px;
                            GreenButton {
                                text: "左对齐";
                                clicked => { root.para-set-align(0); }
                            }
                            GreenButton {
                                text: "居中";
                                clicked => { root.para-set-align(1); }
                            }
                            GreenButton {
                                text: "右对齐";
                                clicked => { root.para-set-align(2); }
                            }
                            GreenButton {
                                text: "首行缩进";
                                clicked => { root.para-indent-toggle(true); }
                            }
                            GreenButton {
                                text: "取消缩进";
                                clicked => { root.para-indent-toggle(false); }
                            }
                            GreenButton {
                                text: "导入docx";
                                clicked => { root.import-docx(); }
                            }
                        }
                        Text {
                            text: root.para-status-text;
                            font-size: 11px;
                            color: Theme.sub-text;
                        }
                        para-editor := Rectangle {
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.group-border;
                            background: #ffffff;
                            // 编辑区加高（对齐 Python 版 QTextEdit min 120 / max 200），
                            // 长段落换行后可见行数更多
                            height: 190px;
                            clip: true;
                            scroll-view := ScrollView {
                                x: 4px;
                                y: 4px;
                                width: parent.width - 8px;
                                height: parent.height - 8px;
                                viewport-width: self.visible-width;
                                viewport-height: max(self.visible-height, para-column.preferred-height);
                                viewport-y <=> root.para-viewport-y;
                                para-column := VerticalLayout {
                                    width: scroll-view.visible-width;
                                    spacing: 2px;
                                    // 为叠加式滚动条预留空间：滚动条悬浮出现时不占布局宽度，
                                    // 加 padding-right 防止右侧文字（尤其右对齐段落）被滚动条遮挡。
                                    padding-right: 18px;

                                    // 逐段编辑器：每段独立 TextInput，
                                    // 对齐方式直接绑定段格式（居中/右对齐即刻可见），
                                    // 首行缩进以前置留白条可视化（仅编辑区示意，预览为准）。
                                    for row[idx] in root.paragraphs: VerticalLayout {
                                        spacing: 0px;
                                        vertical-stretch: 0;

                                        HorizontalLayout {
                                            spacing: 0px;
                                            vertical-stretch: 0;

                                            // 首行缩进留白：宽度 = 缩进字符数 × 编辑器字号
                                            Rectangle {
                                                width: max(0, row.indent-em) * Theme.base-font;
                                                animate width { duration: 120ms; }
                                            }
                                            row-input := TextInput {
                                                property <int> focus-ticket: root.focus-nonce;
                                                // 两种时机都尝试聚焦：
                                                // init 覆盖「delegate 晚于令牌变更创建」的情形，
                                                // changed 覆盖「delegate 已存在」的情形
                                                init => {
                                                    if (root.focus-row == idx) {
                                                        self.focus();
                                                    }
                                                }
                                                changed focus-ticket => {
                                                    if (root.focus-row == idx) {
                                                        self.focus();
                                                    }
                                                }
                                                changed has-focus => {
                                                    if (self.has-focus) {
                                                        root.para-cursor-moved(idx);
                                                    }
                                                }
                                                text: row.text;
                                                single-line: false;
                                                wrap: word-wrap;
                                                font-family: "楷体";
                                                font-size: Theme.base-font;
                                                color: Theme.text;
                                                horizontal-stretch: 1;
                                                // 依靠 Rust 侧估算行数并绑定高度，避免嵌套布局自适应高度失效裁剪内容
                                                height: max(Theme.base-font * 1.5, row.est-lines * Theme.base-font * 1.5);
                                                horizontal-alignment:
                                                    row.align == 1 ? TextHorizontalAlignment.center :
                                                    row.align == 2 ? TextHorizontalAlignment.right :
                                                    TextHorizontalAlignment.left;
                                                page-height: scroll-view.visible-height;
                                                edited => { root.para-text-edited(idx, self.text); }
                                                cursor_position_changed(pos) => { root.para-cursor-moved(idx); }
                                                key-pressed(event) => {
                                                    if (event.text == "\n"
                                                        && !event.modifiers.control && !event.modifiers.alt
                                                        && self.anchor-position-byte-offset == self.cursor-position-byte-offset) {
                                                        root.para-split(idx, self.cursor-position-byte-offset);
                                                        accept
                                                    } else if (event.text == "\u{8}"
                                                        && self.cursor-position-byte-offset == 0
                                                        && self.anchor-position-byte-offset == 0) {
                                                        root.para-merge-prev(idx);
                                                        accept
                                                    } else {
                                                        reject
                                                    }
                                                }
                                            }
                                            // 末尾空格占位块（仅右对齐生效）：
                                            // 宽度 = 末尾空格数 × 空格宽度（≈ 0.55 × 字号），
                                            // 将 TextInput 可用宽度向左收窄，令右对齐文字随尾部空格同步左移。
                                            Rectangle {
                                                width: row.align == 2
                                                    ? row.trailing-space-em * Theme.base-font
                                                    : 0;
                                            }
                                        }

                                        // 段落分隔线：让每段的边界清晰可见
                                        Rectangle {
                                            height: 1px;
                                            vertical-stretch: 0;
                                            background: #eef2ee;
                                        }
                                    }

                                    // 底部空白区：点击聚焦最后一段（模拟整框编辑手感）
                                    Rectangle {
                                        vertical-stretch: 1;
                                        min-height: 30px;
                                        TouchArea {
                                            clicked => { root.para-focus-last(); }
                                        }
                                    }
                                }
                            }
                            Text {
                                text: "请输入文本内容，支持多段；回车分段，用上方按钮设置当前段格式。";
                                visible: root.paragraphs.length == 0
                                    || (root.paragraphs.length == 1 && root.paragraphs[0].text == "");
                                x: 12px;
                                y: 12px;
                                width: parent.width - 24px;
                                font-size: 12px;
                                color: Theme.sub-text;
                                wrap: word-wrap;
                            }
                        }

                        // ---- 框选文字区域（实验：手写/打印混排，对齐 Python 版区域面板） ----
                        HorizontalLayout {
                            spacing: 6px;
                            SectionLabel { text: "框选文字区域"; horizontal-stretch: 1; }
                            region-mode-btn := GreenButton {
                                text: root.region-mode ? "框选：开" : "框选：关";
                                clicked => { root.toggle-region-mode(); }
                            }
                        }
                        Text {
                            text: "开启框选后在预览图上拖出矩形；点列表项可在预览中拖动/缩放调整框，双击编辑文字。";
                            font-size: 11px;
                            color: Theme.sub-text;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.group-border;
                            background: #ffffff;
                            height: 96px;
                            clip: true;
                            region-scroll := ScrollView {
                                x: 4px;
                                y: 4px;
                                width: parent.width - 8px;
                                height: parent.height - 8px;
                                viewport-width: self.visible-width;
                                viewport-height: max(self.visible-height, region-column.preferred-height);
                                VerticalLayout {
                                    region-column := VerticalLayout {
                                        width: region-scroll.visible-width;
                                        spacing: 2px;
                                        for lbl[i] in root.region-labels: Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: i == root.region-selected-index ? #e3efe6
                                                : i == root.highlight-index ? #f0f5ee : transparent;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                Text {
                                                    text: lbl;
                                                    font-size: 11px;
                                                    color: Theme.text;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                            TouchArea {
                                                changed has-hover => {
                                                    root.region-item-hovered(self.has-hover ? i : -1);
                                                }
                                                clicked => {
                                                    root.region-selected-index = i;
                                                    root.region-item-clicked(i);
                                                }
                                                double-clicked => { root.region-edit-requested(i); }
                                            }
                                        }
                                        // 空列表占位提示
                                        Text {
                                            text: "（暂无区域）";
                                            visible: root.region-labels.length == 0;
                                            font-size: 11px;
                                            color: Theme.sub-text;
                                        }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            GreenButton {
                                text: "删除选中";
                                enabled: root.region-selected-index >= 0
                                    && root.region-selected-index < root.region-labels.length;
                                clicked => {
                                    root.region-delete(root.region-selected-index);
                                    root.region-selected-index = -1;
                                }
                            }
                            GreenButton {
                                text: "清空全部";
                                enabled: root.region-labels.length > 0;
                                clicked => {
                                    root.region-clear();
                                    root.region-selected-index = -1;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        // ---- 字体 / 背景文件选择 ----
                        GridLayout {
                            spacing: 6px;
                            Row {
                                FieldLabel { text: "字体"; }
                                font-path-edit := LineEdit {
                                    placeholder-text: "未选择字体";
                                    horizontal-stretch: 1;
                                    min-width: 60px;
                                }
                                GreenButton {
                                    text: "选择";
                                    clicked => { root.choose-font(); }
                                }
                            }
                            Row {
                                FieldLabel { text: "背景"; }
                                background-path-edit := LineEdit {
                                    placeholder-text: "未选择背景";
                                    horizontal-stretch: 1;
                                    min-width: 60px;
                                }
                                GreenButton {
                                    text: "选择";
                                    clicked => { root.choose-background(); }
                                }
                            }
                            Row {
                                FieldLabel { text: "文档底图"; }
                                Text {
                                    text: root.doc-status-text == "" ? "导入 PDF/DOCX 打印预览作为多页底图" : root.doc-status-text;
                                    font-size: 11px;
                                    color: Theme.sub-text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                GreenButton {
                                    text: "导入…";
                                    clicked => { root.import-document(); }
                                }
                            }
                        }

                        // ---- 文字颜色（#RRGGBB 十六进制） ----
                        HorizontalLayout {
                            spacing: 6px;
                            FieldLabel { text: "文字颜色"; }
                            font-color-edit := LineEdit {
                                text: "#000000";
                                placeholder-text: "#000000";
                                min-width: 96px;
                                horizontal-stretch: 0;
                                horizontal-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        // ---- 预设：下拉快捷切换 + 载入/保存 ----
                        HorizontalLayout {
                            spacing: 6px;
                            FieldLabel { text: "预设"; }
                            preset-combo := ComboBox {
                                model: root.preset-list;
                                current-index: root.preset-index;
                                selected => { root.preset-selected(preset-combo.current-index); }
                                horizontal-stretch: 1;
                                min-width: 90px;
                            }
                            GreenButton {
                                text: "载入预设";
                                clicked => { root.load-preset(); }
                            }
                            GreenButton {
                                text: "保存预设";
                                clicked => { root.save-preset(); }
                            }
                        }

                        // ---- 排版参数（数值 + 扰动 σ 表格，对齐 Python 版 QGroupBox） ----
                        Rectangle {
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.group-border;
                            GroupTitle { text: "排版参数"; x: 10px; y: -8px; }
                            GridLayout {
                                padding-top: 16px;
                                padding-bottom: 10px;
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                Row {
                                    Rectangle { }
                                    FieldLabel { text: "数值"; font-weight: 700; horizontal-alignment: center; }
                                    Rectangle { width: 14px; }
                                    FieldLabel { text: "扰动 σ"; font-weight: 700; horizontal-alignment: center; }
                                }
                                Row {
                                    FieldLabel { text: "字水平间距"; }
                                    word-spacing-spin := SpinBox {
                                        value: 5; minimum: 0; maximum: 100;
                                        min-width: 70px;
                                        horizontal-alignment: center;
                                    }
                                    FieldLabel { text: "σ"; horizontal-alignment: center; }
                                    word-spacing-sigma-spin := SpinBox {
                                        value: 2; minimum: 0; maximum: 20;
                                        min-width: 70px;
                                        horizontal-alignment: center;
                                    }
                                }
                                Row {
                                    FieldLabel { text: "字竖直间距"; }
                                    line-spacing-spin := SpinBox {
                                        value: 48; minimum: 0; maximum: 200;
                                        min-width: 70px;
                                        horizontal-alignment: center;
                                    }
                                    FieldLabel { text: "σ"; horizontal-alignment: center; }
                                    line-spacing-sigma-spin := SpinBox {
                                        value: 2; minimum: 0; maximum: 20;
                                        min-width: 70px;
                                        horizontal-alignment: center;
                                    }
                                }
                                Row {
                                    FieldLabel { text: "字体大小"; }
                                    font-size-spin := SpinBox {
                                        value: 36; minimum: 8; maximum: 200;
                                        min-width: 70px;
                                        horizontal-alignment: center;
                                    }
                                    FieldLabel { text: "σ"; horizontal-alignment: center; }
                                    font-size-sigma-spin := SpinBox {
                                        value: 2; minimum: 0; maximum: 20;
                                        min-width: 70px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }

                        // ---- 笔画扰动 ----
                        Rectangle {
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.group-border;
                            GroupTitle { text: "笔画扰动"; x: 10px; y: -8px; }
                            GridLayout {
                                padding-top: 16px;
                                padding-bottom: 10px;
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                Row {
                                    FieldLabel { text: "水平笔画位移"; }
                                    perturb-x-spin := SpinBox {
                                        value: 2; minimum: 0; maximum: 20;
                                        horizontal-stretch: 1;
                                        horizontal-alignment: center;
                                    }
                                }
                                Row {
                                    FieldLabel { text: "竖直笔画位移"; }
                                    perturb-y-spin := SpinBox {
                                        value: 2; minimum: 0; maximum: 20;
                                        horizontal-stretch: 1;
                                        horizontal-alignment: center;
                                    }
                                }
                                Row {
                                    FieldLabel { text: "笔画旋转"; }
                                    perturb-theta-edit := LineEdit {
                                        text: "0.05";
                                        placeholder-text: "0.05";
                                        horizontal-stretch: 1;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }

                        // ---- 写错字模拟 ----
                        Rectangle {
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.group-border;
                            GroupTitle { text: "写错字"; x: 10px; y: -8px; }
                            GridLayout {
                                padding-top: 16px;
                                padding-bottom: 10px;
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                Row {
                                    FieldLabel { text: "错字率"; }
                                    miswrite-rate-slider := Slider {
                                        value: 0; minimum: 0; maximum: 30; step: 0.1;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        // Slint 字符串插值语法为 \{...}（${...} 会被当作字面文本）
                                        text: "\{round(root.miswrite-rate * 10) / 10}%";
                                        width: 48px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-size: 12px;
                                        color: Theme.text;
                                    }
                                }
                                Row {
                                    FieldLabel { text: "重写方式"; }
                                    miswrite-mode-combo := ComboBox {
                                        model: ["右上方重写", "后文重写"];
                                        current-index: 0;
                                        horizontal-stretch: 1;
                                    }
                                }
                                Row {
                                    FieldLabel { text: "涂改方式"; }
                                    miswrite-strikeout-combo := ComboBox {
                                        model: ["单横线", "双横线", "斜线", "叉号"];
                                        current-index: 0;
                                        horizontal-stretch: 1;
                                    }
                                }
                            }
                        }

                        // ---- 边距：位置式布局（上/下/左/右环绕中心「边距」） ----
                        Rectangle {
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.group-border;
                            GroupTitle { text: "边距"; x: 10px; y: -8px; }
                            GridLayout {
                                padding-top: 16px;
                                padding-bottom: 10px;
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                Row {
                                    Rectangle { }
                                margin-top-spin := SpinBox {
                                        value: 30; minimum: 0; maximum: 3000;
                                        horizontal-alignment: center;
                                    }
                                    Rectangle { }
                                }
                                Row {
                                    margin-left-spin := SpinBox { value: 30; minimum: 0; maximum: 3000; }
                                    Text {
                                        text: "边距";
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        font-family: "楷体";
                                        font-weight: 700;
                                        color: #4ca6a6;
                                    }
                                    margin-right-spin := SpinBox { value: 30; minimum: 0; maximum: 3000; }
                                }
                                Row {
                                    Rectangle { }
                                    margin-bottom-spin := SpinBox {
                                        value: 30; minimum: 0; maximum: 3000;
                                        horizontal-alignment: center;
                                    }
                                    Rectangle { }
                                }
                                Row {
                                    bounds-check := CheckBox { text: "边界提示(仅预览)"; }
                                    bounds-color-edit := LineEdit {
                                        text: "#4ca6a6";
                                        placeholder-text: "#4ca6a6";
                                        min-width: 96px;
                                        horizontal-stretch: 0;
                                        horizontal-alignment: center;
                                    }
                                    Rectangle { }
                                }
                            }
                        }

                        Text {
                            text: "提示：选择字体与背景后点击「预览」";
                            font-family: "楷体";
                            font-size: 11px;
                            color: Theme.sub-text;
                        }
                    }
                }

                // ---- 底部主按钮（对齐 Python 版 primary 按钮行） ----
                HorizontalLayout {
                    spacing: 10px;
                    PrimaryButton {
                        text: "预览";
                        horizontal-stretch: 1;
                        clicked => { root.regenerate(); }
                    }
                    PrimaryButton {
                        text: "导出";
                        horizontal-stretch: 1;
                        clicked => { root.export-files(); }
                    }
                    PrimaryButton {
                        text: "导出 PDF";
                        horizontal-stretch: 1;
                        clicked => { root.export-pdf(); }
                    }
                }
            }
        }

        // ---- 底部状态栏 ----
        // 当前使用 GPLv3 版 Slint，无归因展示义务，故不显示 AboutSlint。
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: status-text;
                horizontal-stretch: 1;
                vertical-alignment: center;
                font-family: "楷体";
                font-size: 12px;
                color: Theme.sub-text;
            }
        }
    }

    // ---- 区域编辑对话框（窗口内模态覆盖层，对应 Python 版 RegionDialog） ----
    Rectangle {
        visible: root.dialog-open;
        background: #00000060;
        TouchArea { }  // 挡住底层点击

        Rectangle {
            width: min(440px, parent.width - 24px);
            height: min(400px, parent.height - 24px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: white;
            border-radius: 8px;

            VerticalLayout {
                padding: 16px;
                spacing: 8px;

                Text {
                    text: root.dialog-target-index >= 0 ? "编辑文字区域" : "添加文字区域";
                    font-family: "楷体";
                    font-size: Theme.base-font * 1.15;
                    font-weight: 700;
                    color: Theme.text;
                }
                Text { text: "区域文字"; font-size: 12px; color: Theme.text; }
                Rectangle {
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.group-border;
                    height: 84px;
                    clip: true;
                    ScrollView {
                        x: 4px; y: 4px;
                        width: parent.width - 8px;
                        height: parent.height - 8px;
                        viewport-width: self.visible-width;
                        viewport-height: max(self.visible-height, dialog-input.preferred-height);
                        dialog-input := TextInput {
                            width: parent.visible-width;
                            text <=> root.dialog-text;
                            single-line: false;
                            wrap: word-wrap;
                            font-family: "楷体";
                            font-size: Theme.base-font;
                            color: Theme.text;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    FieldLabel { text: "样式"; }
                    ComboBox {
                        model: ["手写体", "打印体"];
                        current-index <=> root.dialog-style-index;
                        horizontal-stretch: 1;
                    }
                    FieldLabel { text: "起始页"; }
                    SpinBox {
                        value <=> root.dialog-page;
                        minimum: 1;
                        maximum: 999;
                        width: 86px;
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    FieldLabel { text: "打印字体"; }
                    LineEdit {
                        text <=> root.dialog-font-path;
                        placeholder-text: "留空使用主字体";
                        horizontal-stretch: 1;
                        enabled: root.dialog-style-index == 1;
                    }
                    GreenButton {
                        text: "选择";
                        enabled: root.dialog-style-index == 1;
                        clicked => { root.choose-region-font(); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    FieldLabel { text: "字号"; }
                    SpinBox {
                        value <=> root.dialog-font-size;
                        minimum: 0;
                        maximum: 300;
                        width: 86px;
                    }
                    Text {
                        text: "0 = 跟随主设置；打印体不做笔画扰动、排版规整。";
                        font-size: 11px;
                        color: Theme.sub-text;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    PrimaryButton {
                        text: "取消";
                        horizontal-stretch: 1;
                        clicked => {
                            root.dialog-open = false;
                            root.region-dialog-cancelled();
                        }
                    }
                    PrimaryButton {
                        text: "确定";
                        horizontal-stretch: 1;
                        clicked => {
                            root.dialog-open = false;
                            root.region-dialog-confirmed(
                                root.dialog-target-index,
                                root.dialog-text,
                                root.dialog-style-index == 1,
                                root.dialog-font-path,
                                root.dialog-font-size,
                                root.dialog-page,
                            );
                        }
                    }
                }
            }
        }
    }
}
